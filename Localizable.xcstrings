    "Onboarding_Consultation_Description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With the AI consultation feature, you'll receive personalized recommendations based on your child's sleep statistics. Using OpenAI algorithms, the app analyzes the data and offers solutions to improve sleep quality."
          }
        },
        "kk-KZ" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI консультациясы функциясы арқылы сіз балаңыздың ұйқы статистикасына негізделген жеке ұсыныстарды аласыз. OpenAI алгоритмдерін пайдаланып, қолданба деректерді талдайды және ұйқы сапасын жақсарту үшін шешімдер ұсынады."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С функцией консультации ИИ вы получите персонализированные рекомендации на основе статистики сна вашего ребенка. Используя алгоритмы OpenAI, приложение анализирует данные и предлагает решения для улучшения качества сна."
          }
        }
      }
    },
    "Onboarding_Consultation_Title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultation"
          }
        },
        "kk-KZ" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Консультация"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Консультация"
          }
        }
      }
    },
    "Onboarding_Sleep_Description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With the sleep tracking feature, you can easily add and manage your child's sleep times, recording the start and end of each period. This helps monitor sleep patterns and quality, analyze data, and improve your child's sleep habits."
          }
        },
        "kk-KZ" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ұйқыны бақылау функциясы арқылы сіз балаңыздың ұйқы уақыттарын оңай қосып, басқара аласыз, әр кезеңнің басталуын және аяқталуын жазып аласыз. Бұл ұйқы режимін және сапасын бақылауға, деректерді талдауға және балаңыздың ұйқы әдеттерін жақсартуға көмектеседі."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С функцией отслеживания сна вы легко сможете добавлять и управлять временем сна вашего ребенка, записывая начало и окончание каждого периода. Это поможет следить за режимом и качеством сна, анализировать данные и улучшать привычки сна малыша."
          }
        }
      }
    },
    "Onboarding_Sleep_Title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
