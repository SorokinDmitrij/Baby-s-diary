    },
    "Onboarding_Statistics_Description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With the sleep statistics feature, you can track and analyze your child's sleep patterns by recording data. Share this statistics with experts for professional recommendations."
          }
        },
        "kk-KZ" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ұйқы статистикасы функциясы арқылы сіз деректерді жазу арқылы балаңыздың ұйқы режимдерін қадағалап, талдай аласыз. Кәсіби ұсыныстар алу үшін осы статистиканы мамандармен бөлісіңіз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С функцией статистики сна вы сможете отслеживать и анализировать режимы сна ребенка, записывая данные. Делитесь этой статистикой с экспертами для профессиональных рекомендаций."
          }
        }
      }
    },
